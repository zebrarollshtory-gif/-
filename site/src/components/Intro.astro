---
import { SITE, ANSWERS } from '../data/site';
// Окна (в % от кадра 1536×1024): левый край, правый отступ
const panes = [[15.1, 67.1], [33.2, 49.5], [50.8, 32.3], [68.0, 15.4]];
---
<section class="intro" id="intro" aria-labelledby="intro-title">
  <div class="scene" aria-hidden="true">
    <div class="frame">
      <img src="/img/intro-light.webp" alt="" class="layer" width="1536" height="1024" fetchpriority="high" />
      <div class="beam"></div>
      <img src="/img/intro-dark.webp" alt="" class="layer room-dark" width="1536" height="1024" />
      {panes.map(([l, r], i) => <img src="/img/intro-dark.webp" alt="" class="layer pane" data-i={i} style={`--l:${l}%;--r:${r}%`} width="1536" height="1024" />)}
      {panes.map(([l, r], i) => <div class="bar" data-i={i} style={`left:${l}%;width:${(100 - l - r).toFixed(1)}%`}></div>)}
      <img src="/img/intro-fg-light.webp" alt="" class="fg" width="1073" height="120" />
      <img src="/img/intro-fg-dark.webp" alt="" class="fg fg-dark" width="1073" height="120" />
    </div>
    <div class="vignette"></div>
  </div>

  <div class="choice">
    <div class="choice-head">
      <h1 id="intro-title">{SITE.slogan}</h1>
      <p>Ролл-шторы, жалюзи и электрокарнизы в Астане. Выберите, что вам нужно:</p>
    </div>
    <div class="cards">
      <a class="neon" href="/home/" data-event="choice" data-place="home">
        <article>
          <img src="/img/home-alu-bronze.webp" alt="Жалюзи в гостиной — наша работа" width="540" height="210" />
          <div class="body">
            <div class="kicker">Астана</div>
            <h2>Для дома</h2>
            <p>Бесплатный замер с образцами тканей. Расчёт стоимости по запросу.</p>
            <span class="badge">{ANSWERS.sameDay}</span>
            <div class="chips"><span>Ролл-шторы</span><span>Жалюзи</span><span>Римские шторы</span><span>Электрокарнизы</span></div>
            <span class="go go-accent">Подобрать для дома →</span>
          </div>
        </article>
      </a>
      <a class="neon" href="/business/" data-event="choice" data-place="business">
        <article>
          <img src="/img/work-office-sunset.webp" alt="Офис с ролл-шторами и портьерами — наша работа" width="540" height="210" />
          <div class="body">
            <div class="kicker">Весь Казахстан</div>
            <h2>Для бизнеса</h2>
            <p>Офисы, гостиницы, клиники, школы. Поможем составить техническое задание.</p>
            <div class="chips"><span>Офисы и БЦ</span><span>Гостиницы</span><span>Клиники и школы</span><span>Дизайнерам</span></div>
            <span class="go go-dark">Решения для бизнеса →</span>
          </div>
        </article>
      </a>
    </div>
  </div>

  <div class="controls">
    <button type="button" class="skip">Пропустить</button>
    <button type="button" class="replay" aria-label="Повторить анимацию">Повторить</button>
  </div>
</section>
<script is:inline>(function(){var r=document.getElementById("intro");var m=window.matchMedia("(prefers-reduced-motion: reduce)").matches;var s=false;try{s=sessionStorage.getItem("zq-intro")==="1"}catch(e){}if(!m&&!s)r.classList.add("pre")})();</script>

<style>
  .intro { position: relative; overflow: hidden; background: radial-gradient(ellipse at 50% 35%, #2c3e52 0%, #1f2d3d 55%, #152029 100%); min-height: min(820px, 92vh); display: flex; }
  .scene { position: absolute; inset: 0; background: #14110f; z-index: 2; pointer-events: none; transition: opacity .1s linear; }
  .frame { position: absolute; left: 50%; top: 0; width: max(100%, 1040px); aspect-ratio: 3 / 2; transform: translateX(-50%) translateY(-7%) scale(var(--cam, 1)); transform-origin: 50% 45%; }
  .layer { position: absolute; inset: 0; width: 100%; height: 100%; }
  .room-dark { opacity: var(--dark, 0); }
  .pane { clip-path: inset(18.6% var(--r) var(--bb, 81.4%) var(--l)); }
  .bar { position: absolute; height: 1.1%; background: linear-gradient(#6a665f, #2f2d2a); box-shadow: 0 3px 8px rgba(0,0,0,.4); opacity: var(--barop, 0); }
  .fg { position: absolute; left: 15.104%; top: 56.641%; width: 69.857%; height: 11.719%; }
  .fg-dark { opacity: var(--dark, 0); }
  .beam { position: absolute; left: 16%; top: 18%; width: 68%; height: 72%; background: linear-gradient(to bottom, rgba(255,244,196,.55), rgba(255,244,196,0)); clip-path: polygon(8% 0, 92% 0, 118% 100%, -18% 100%); mix-blend-mode: screen; opacity: var(--beam, 0); }
  .vignette { position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(0,0,0,0) 55%, rgba(0,0,0,.5) 100%); }

  .choice { position: relative; z-index: 1; width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px var(--gutter); }
  .choice-head { text-align: center; color: #fff6e8; }
  .choice-head h1 { font-size: clamp(28px, 3.4vw, 46px); font-weight: 800; }
  .choice-head p { margin: 8px 0 0; color: #d9e0e6; font-size: 17px; }
  .cards { display: flex; flex-wrap: wrap; gap: 36px; justify-content: center; margin-top: 30px; width: 100%; max-width: 1120px; }
  .neon { flex: 1 1 420px; max-width: 540px; display: flex; flex-direction: column; border: 1.5px solid rgba(255,255,255,.55); border-radius: 22px; padding: 9px; transition: transform .35s ease; }
  .neon article { background: #f7f1e6; border-radius: 15px; overflow: hidden; flex: 1; display: flex; flex-direction: column; color: var(--ink); }
  .neon img { height: 210px; width: 100%; object-fit: cover; }
  .body { padding: 20px 24px 24px; flex: 1; display: flex; flex-direction: column; }
  .body h2 { font-size: 34px; font-weight: 800; margin-top: 2px; }
  .body p { font-size: 15px; line-height: 1.5; color: var(--ink-2); margin: 6px 0 0; }
  .body .badge { align-self: flex-start; margin-top: 10px; font-size: 13px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 18px; }
  .chips span { border: 1px solid #d6cbb6; border-radius: 999px; padding: 6px 12px; font-size: 13px; }
  .go { display: block; text-align: center; margin-top: auto; padding: 15px; font-size: 16px; font-weight: 700; border-radius: 10px; color: #fff; }
  .go-accent { background: var(--accent); }
  .go-dark { background: var(--ink); }
  @keyframes flow { to { background-position: 400% 0; } }
  @keyframes glow { 0%,100% { box-shadow: 0 0 26px rgba(255,43,214,.75), 0 0 60px rgba(255,43,214,.35); } 25% { box-shadow: 0 0 26px rgba(122,92,255,.75), 0 0 60px rgba(122,92,255,.35); } 50% { box-shadow: 0 0 26px rgba(0,229,255,.75), 0 0 60px rgba(0,229,255,.35); } 75% { box-shadow: 0 0 26px rgba(57,255,136,.75), 0 0 60px rgba(57,255,136,.35); } }
  .neon:hover, .neon:focus-visible, .neon:active { background: linear-gradient(90deg, #ff2bd6, #7a5cff, #00e5ff, #39ff88, #ffd400, #ff2bd6); background-size: 400% 100%; border-color: transparent; animation: flow 4s linear infinite, glow 4s linear infinite; transform: translateY(-4px); }

  .controls { position: absolute; right: 16px; top: 16px; z-index: 3; display: flex; gap: 8px; }
  .controls button { background: rgba(255,255,255,.92); color: var(--ink); border: 0; border-radius: 999px; padding: 10px 18px; font: 600 14px 'Onest', sans-serif; cursor: pointer; min-height: 40px; }
  .intro:not(.js) .scene, .intro:not(.js) .controls { display: none; }
  .intro.done .skip { display: none; }
  .intro.pre .choice { opacity: 0; }

  @media (max-width: 700px) {
    .frame { width: 200%; transform: translateX(-50%) translateY(6%) scale(var(--cam, 1)); }
    .neon { flex-basis: 100%; }
    .neon img { height: 120px; }
    .body h2 { font-size: 26px; }
    .cards { gap: 14px; margin-top: 18px; }
    .choice { padding-top: 64px; }
    .controls { top: 12px; right: 12px; }
    .controls button { padding: 8px 14px; font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scene, .controls { display: none !important; }
    .neon:hover, .neon:active { animation: none; transform: none; box-shadow: 0 0 0 3px #00e5ff; }
  }
</style>

<script>
  const root = document.getElementById('intro') as HTMLElement;
  const scene = root.querySelector('.scene') as HTMLElement;
  const choice = root.querySelector('.choice') as HTMLElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const seen = (() => { try { return sessionStorage.getItem('zq-intro') === '1'; } catch { return false; } })();
  const c = (v: number) => Math.max(0, Math.min(1, v));
  const ease = (v: number) => 1 - Math.pow(1 - v, 3);
  const DURATION = 6000;
  let start = 0, raf = 0;

  function render(t: number) {
    const fb = [0, 1, 2, 3].map((i) => ease(c((t - 0.16 - 0.035 * i) / 0.36)));
    const out = ease(c((t - 0.68) / 0.16));
    const inn = ease(c((t - 0.72) / 0.26));
    const s = root.style;
    s.setProperty('--cam', (1 + 0.07 * c(t / 0.6)).toFixed(3));
    s.setProperty('--beam', (0.9 * (1 - fb[1]) * c(t / 0.08)).toFixed(2));
    s.setProperty('--dark', c(0.25 * fb[1] + 0.75 * c((fb[3] - 0.8) / 0.2)).toFixed(2));
    s.setProperty('--barop', (c(fb[0] * 40) * (1 - c((fb[3] - 0.97) / 0.03))).toFixed(2));
    root.querySelectorAll<HTMLElement>('.pane').forEach((p) => p.style.setProperty('--bb', (81.4 - 45.9 * fb[+p.dataset.i!]).toFixed(2) + '%'));
    root.querySelectorAll<HTMLElement>('.bar').forEach((b) => (b.style.top = (18.6 + 45.9 * fb[+b.dataset.i!] - 0.9).toFixed(2) + '%'));
    scene.style.opacity = String(1 - out);
    scene.style.visibility = out >= 1 ? 'hidden' : 'visible';
    choice.style.opacity = c(out * 1.5).toFixed(2);
    choice.style.transform = `translateY(${Math.round((1 - inn) * 40)}px)`;
  }
  function tick(now: number) {
    const t = Math.min(1, (now - start) / DURATION);
    render(t);
    if (t < 1) raf = requestAnimationFrame(tick); else finish();
  }
  function finish() { cancelAnimationFrame(raf); root.classList.remove('pre'); render(1); root.classList.add('done'); try { sessionStorage.setItem('zq-intro', '1'); } catch {} }
  function play() { root.classList.remove('done'); root.classList.remove('pre'); cancelAnimationFrame(raf); start = performance.now(); raf = requestAnimationFrame(tick); }

  root.classList.add('js');
  if (reduce || seen) finish(); else play();
  root.querySelector('.skip')?.addEventListener('click', finish);
  root.querySelector('.replay')?.addEventListener('click', play);
</script>
