---
import Base from '../layouts/Base.astro';
import Facts from '../components/Facts.astro';
import { SITE } from '../data/site';
const values = [['Семья — в широком смысле', 'Создаём пространства для всех форм близости: дома, в офисе, в классе.'], ['Забота как действие', 'Бесплатный замер с образцами, быстрый ответ, монтаж без мусора, контроль после монтажа.'], ['Пространство как язык', 'Физический комфорт снижает конфликтность, приватность даёт покой.'], ['Честность без давления', 'Замер без обязательств, честные цены без «скидок 70% только сегодня».'], ['Казахстанская идентичность', 'Понимаем местный климат и контекст: жару летом, плотную застройку.'], ['Качество как уважение', 'Единый стандарт монтажа, фотоотчёт и акт выполненных работ на каждом объекте.'], ['Современность с человеческим теплом', 'Умное управление — это забота, а не демонстрация технологий.']];
---
<Base title="О компании" description="ZEBRA QAZAQSTAN — собственное производство и монтаж солнцезащитных систем в Астане с 2019 года. Более 50 объектов, 10 000+ м² в год, гарантия 12 месяцев." crumbs={[['О компании', '/about/']]}>
  <section class="hero">
    <div>
      <h1 class="h1">О компании {SITE.brand}</h1>
      <p class="lead">Собственное производство и монтаж солнцезащитных систем в Астане. Работаем с 2019 года: ролл-шторы, жалюзи, римские шторы, электрокарнизы и автоматизация для домов, офисов, гостиниц, клиник и учебных заведений.</p>
      <p class="lead">Наша формула: <strong>правильное пространство делает людей добрее друг к другу.</strong></p>
    </div>
    <figure><img class="photo" src="/img/work-install.webp" alt="Наш монтажник на объекте" width="800" height="420" /><figcaption>Монтаж на объекте — делаем своими бригадами.</figcaption></figure>
  </section>
  <section class="sec"><h2 class="h2">Факты о нас</h2>
    <Facts items={[['с 2019', 'года на рынке'], ['50+', 'объектов сдано'], ['10 000+', 'м² в год'], ['12 мес', 'гарантия'], ['Астана', 'бизнес — весь РК']]} />
    <p class="muted" style="margin:12px 0 0;font-size:14px">Юрлицо: {SITE.legal}. Производство: {SITE.address}. Среди объектов: БЦ «Агар», БЦ «Сигма», Cardiff University, отели Radisson и Ramada by Wyndham, ГП №10, здание телеканала «Хабар», Astana EXPO.</p>
  </section>
  <section class="sec">
    <figure class="card" style="margin:0;padding:clamp(22px,3vw,34px)">
      <div class="kicker">Слово руководителя</div>
      <blockquote style="margin:10px 0 0;font-size:clamp(20px,2.2vw,26px);line-height:1.45;font-weight:600">«Мы создаём пространства, где людям хорошо вместе. Для нас это не просто ролл-шторы, а отношения с людьми. Я рад быть полезным всем, кому мы помогаем.»</blockquote>
      <figcaption style="font-size:15px;margin-top:12px">Основатель {SITE.brand}</figcaption>
    </figure>
  </section>
  <section class="sec"><h2 class="h2">Наши ценности</h2>
    <div class="grid">{values.map(([t, d], i) => <div class="card" style="padding:20px"><div style="font-size:13px;font-weight:700;color:var(--accent)">{String(i + 1).padStart(2, '0')}</div><h3 style="font-size:18px;margin-top:6px;letter-spacing:0">{t}</h3><p style="font-size:15px;line-height:1.55;color:var(--ink-2);margin:6px 0 0">{d}</p></div>)}</div>
    <div class="cta" style="margin-top:22px"><div><h2>{SITE.slogan}</h2><p>Укрепляем семейные ценности через уют, приватность и заботу.</p></div><a class="btn btn-light" href="/projects/">Посмотреть наши объекты</a></div>
  </section>
</Base>
