---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { wa } from '../../data/site';
import { OBJECTS, type Obj } from '../../data/content';
export function getStaticPaths() { return OBJECTS.map((o) => ({ params: { slug: o.slug }, props: { o } })); }
const { o } = Astro.props as { o: Obj };
const href = wa(`Здравствуйте! Видел(а) объект «${o.name}» на вашем сайте, хочу обсудить похожее решение для нашего объекта.`);
const gallery = o.gallery || [[o.img, o.name] as [string, string]];
const others = OBJECTS.filter((x) => x.slug !== o.slug && x.group === o.group).concat(OBJECTS.filter((x) => x.slug !== o.slug && x.group !== o.group)).slice(0, 3);
---
<Base title={`${o.name} — ${o.cat.toLowerCase()}, Астана`} description={`${o.name}, ${o.addr}. ${o.done} Объект ZEBRA QAZAQSTAN.`} crumbs={[['Наши объекты', '/projects/'], [o.name, `/projects/${o.slug}/`]]} wa={href} waLabel="Обсудить объект в WhatsApp" ogImage={o.img}>
  <section class="sec" style="padding-top:16px">
    <div class="kicker">{o.cat} · Астана</div>
    <h1 class="h1" style="margin-top:6px">{o.name}</h1>
    <p class="lead" style="max-width:780px">{o.done}</p>
  </section>
  <section class="sec" style="padding-top:22px"><div class="gallery">{gallery.map(([s, c]) => <figure><img src={s} alt={c} width="600" height="340" style="height:340px" /><figcaption>{c}</figcaption></figure>)}</div></section>
  <section class="sec" style="display:flex;flex-wrap:wrap;gap:24px;align-items:flex-start">
    <aside class="card" style="flex:1 1 300px;max-width:420px;padding:22px">
      <h2 style="font-size:18px;margin-bottom:12px;letter-spacing:0">Коротко об объекте</h2>
      <dl style="margin:0;display:grid;grid-template-columns:auto 1fr;gap:10px 16px;font-size:15px;line-height:1.45">
        <dt class="muted">Тип</dt><dd style="margin:0">{o.cat}</dd>
        <dt class="muted">Адрес</dt><dd style="margin:0">{o.addr}</dd>
        {o.products && <><dt class="muted">Изделия</dt><dd style="margin:0">{o.products.join(', ')}</dd></>}
      </dl>
    </aside>
    <div style="flex:2 1 460px;min-width:0"><h2 class="h2">Что сделали</h2>{(o.story || [o.done]).map((t) => <p style="font-size:17px;line-height:1.65;color:var(--ink-2);margin:0 0 12px">{t}</p>)}</div>
  </section>
  <Cta title="Нужно похожее решение?" text="Ответим в WhatsApp в течение 2 минут в рабочее время. Поможем с техническим заданием и подготовим КП." href={href} label="Обсудить объект в WhatsApp" place="object-cta" />
  <section class="sec"><div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:10px;margin-bottom:16px"><h2 class="h2" style="margin:0">Другие объекты</h2><a href="/projects/" style="font-weight:600;color:var(--accent)">Все объекты →</a></div>
    <div class="grid">{others.map((x) => <a class="card lcard" href={`/projects/${x.slug}/`}><img src={x.img} alt={x.name} loading="lazy" width="600" height="170" style="height:170px" /><div class="body"><div class="kicker">{x.cat}</div><h3>{x.name}</h3></div></a>)}</div>
  </section>
</Base>
